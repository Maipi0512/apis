# Copia este archivo a "application-local.properties" (mismo directorio)
# y completa los valores reales. Ese archivo NO se sube a git (esta en
# .gitignore) -- este .example si se sube, para que el resto del equipo
# sepa que claves tiene que definir.

DB_USERNAME=postgres.tu_usuario_de_supabase
DB_PASSWORD=tu_password_de_supabase

# Clave para firmar los JWT: cualquier string de al menos 64 caracteres
# hex (256 bits). La pueden generar con: openssl rand -hex 64
JWT_SECRET_KEY=
